    },
    {
      "page": "/store",
      "regex": "^/store(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/store(?:/)?$"
    },
    {
      "page": "/store/orders",
      "regex": "^/store/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/store/orders(?:/)?$"
    },
    {
      "page": "/store/products",
      "regex": "^/store/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/store/products(?:/)?$"
    },
    {
      "page": "/store/products/new",
      "regex": "^/store/products/new(?:/)?$",
      "routeKeys": {},
