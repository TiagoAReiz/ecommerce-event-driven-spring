    {
      "page": "/orders",
      "regex": "^/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/orders(?:/)?$"
    },
    {
      "page": "/products",
      "regex": "^/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/products(?:/)?$"
    },
    {
      "page": "/reviews/mine",
      "regex": "^/reviews/mine(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reviews/mine(?:/)?$"
    },
    {
      "page": "/reviews/pending",
      "regex": "^/reviews/pending(?:/)?$",
