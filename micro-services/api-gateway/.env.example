# =====================================================================
# Variáveis de ambiente específicas do API Gateway
# Copie este arquivo para .env (não versionado) e preencha com seus valores
# =====================================================================

# Google OAuth - credenciais do cliente
# Obtenha em: https://console.cloud.google.com/
# Usado por: api-gateway (autenticação OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
