# =====================================================================
# Variaveis da stack. Copie para .env e preencha o que quiser usar.
#
# NADA aqui e obrigatorio para subir: o compose tem default para tudo.
# O que falta so limita o que funciona, e cada bloco diz o que.
# =====================================================================

STORE_OWNER_EMAIL=owner@example.com

# Credenciais do Mercado Pago
# Usado por: payment
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_NOTIFICATION_URL=

# Secrets dos clientes de serviço internos
# Padrão local: dev-<serviço>-secret
# Usado por: gateway (validação), todos os serviços (como cliente)
USER_CLIENT_SECRET=dev-user-secret
INVENTORY_CLIENT_SECRET=dev-inventory-secret
ORDER_CLIENT_SECRET=dev-order-secret
PAYMENT_CLIENT_SECRET=dev-payment-secret
SHIPMENT_CLIENT_SECRET=dev-shipment-secret

# URL do frontend
# Padrão local: http://localhost:3000
# Usado por: gateway
FRONT_URL=http://localhost:3000

# Credenciais do Debezium para acessar o Postgres
# Padrão: postgres/postgres (compatível com o compose de dev)
# Usado por: connect (Kafka Connect)
DEBEZIUM_DB_USER=postgres
DEBEZIUM_DB_PASSWORD=postgres

# Webhook secret do Mercado Pago
# Padrão local: dev-webhook-secret
# Usado por: gateway
MP_WEBHOOK_SECRET=dev-webhook-secret

# Login pelo Google - sem isso nao ha login
# Redirect autorizado no Google Cloud: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Armazenamento das fotos de produto (MinIO, no proprio compose)
# Os defaults servem para rodar local; troque em qualquer ambiente de verdade.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=produtos
# Endereco pelo qual o NAVEGADOR baixa a foto e envia o arquivo
S3_PUBLIC_URL=http://localhost:9000
